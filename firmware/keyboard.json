{
    "keyboard_name": "My Hackpad",
    "manufacturer":"Custom",
    "maintainer": "siddhantverma04",
    "url": "https://github.com/siddhantverma04/My-HackPad",


    "processor": "RP2040",
    "bootloader": "rp2040",

    "usb": {
        "vid": "0xFEED",
        "pid": "0x0001",
        "device_version": "1.0.0"
    },

    "diode_direction": "COL2ROW",

    "matrix_pins": {
        "rows": ["GP3", "GP4", "GP2"],
        "cols": ["GP26", "GP27", "GP28"],
        "ghost": true
    },

    "features": {
        "bootmagic": true,
        "extrakey": true
    },

    "layouts": {
        "LAYOUT":{
            "layout": [
                {"matrix": [0,0], "x": 0, "y": 0},
                {"matrix": [0,1], "x": 1, "y": 0},
                {"matrix": [0,2], "x": 2, "y": 0},

                {"matrix": [1,0], "x": 0, "y": 1},
                {"matrix": [1,1], "x": 1, "y": 1},
                {"matrix": [1,2], "x": 2, "y": 1},

                {"matrix": [2,0], "x": 0, "y": 2},
                {"matrix": [2,1], "x": 1, "y": 2},
                {"matrix": [2,2], "x": 2, "y": 2}
            ]
        }
    }
}