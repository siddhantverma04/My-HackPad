{
    "keyboard_name": "My Hackpad",
    "manufacturer": "Custom",
    "maintainer": "siddhantverma04",
    "url": "https://github.com/siddhantverma04/My-HackPad",

    "processor": "RP2040",
    "bootloader": "rp2040",

    "usb": {
        "vid": "0xFEED",
        "pid": "0x0001",
        "device_version": "1.0.0"
    },

    "diode_direction": "COL2ROW",

    "matrix_pins": {
        "rows": ["GP3", "GP4", "GP2"],
        "cols": ["GP26", "GP28", "GP29"]
    },

    "ws2812": {
        "driver": "vendor",
        "pin": "GP27"
    },
    
    "rgblight": {
        "led_count": 4,
        "animations": {
            "breathing": true,
            "rainbow_mood": true,
            "rainbow_swirl": true
        },
        "default": {
            "on": true,
            "animation": "rainbow_mood",
            "val": 120
        }
    },

    "features": {
        "bootmagic": true,
        "extrakey": true
    },

    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0,0], "x": 0, "y": 0},
                {"matrix": [0,1], "x": 1, "y": 0},
                {"matrix": [0,2], "x": 2, "y": 0},
                {"matrix": [1,0], "x": 0, "y": 1},
                {"matrix": [1,1], "x": 1, "y": 1},
                {"matrix": [1,2], "x": 2, "y": 1},
                {"matrix": [2,0], "x": 0, "y": 2},
                {"matrix": [2,1], "x": 1, "y": 2},
                {"matrix": [2,2], "x": 2, "y": 2}
            ]
        }
    }
}